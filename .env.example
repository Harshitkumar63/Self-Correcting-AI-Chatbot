# ══════════════════════════════════════════════════════════════
# Self-Improving LLM Pipeline — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and customize values as needed.

# ── Backend ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///app.db
SECRET_KEY=change-me-to-a-random-secret-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── ML Pipeline ──────────────────────────────────────────────
INFERENCE_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
EVAL_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.70
FINE_TUNE_TRIGGER_COUNT=50
DEVICE=auto

# ── LoRA Training ────────────────────────────────────────────
LORA_R=8
LORA_ALPHA=32
TRAINING_EPOCHS=3
TRAINING_BATCH_SIZE=4
LEARNING_RATE=0.0002

# ── Auth ─────────────────────────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
JWT_EXPIRATION_MINUTES=1440

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
